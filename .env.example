# Copy this file to .env and fill in your own values.
# .env is gitignored; this example is the one that gets committed.
#
# Flutter reads API_BASE at build time:
#   cd app
#   flutter build apk --release --dart-define-from-file=../.env
#
# Node scripts read the rest automatically through
# --env-file-if-exists=.env in package.json.

# The API address. 127.0.0.1 works over USB after
#   adb reverse tcp:3000 tcp:3000
# For a phone on the same network, use the laptop's LAN address.
API_BASE=http://127.0.0.1:3000

# API server
PORT=3000
DATABASE_URL=postgres://wimb:wimb_local_dev@localhost:5432/wimb
# JWT_SECRET=change-me-for-anything-public

# Postgres container
POSTGRES_DB=wimb
POSTGRES_USER=wimb
POSTGRES_PASSWORD=wimb_local_dev
POSTGRES_PORT=5432

# Recorded archive and static GTFS snapshot
DATA_ROOT=./data
PROFILE_GTFS_ROOT=./delhi_buses_static_gtfs_v1

# Recorder VM
RECORDER_HOST=recorder.example.com
SSH_KEY=C:/Users/your-name/.ssh/id_ed25519
