{
  "name": "where-is-my-bus",
  "version": "0.1.0",
  "private": true,
  "description": "Bus tracking for Delhi with honest uncertainty. Analysis tools.",
  "scripts": {
    "peek": "node --env-file-if-exists=.env tools/peek-frame.js",
    "scan-archive": "node --env-file-if-exists=.env tools/scan-archive.js",
    "profile-gtfs": "node --env-file-if-exists=.env tools/profile-gtfs.js",
    "load-realtime": "node --env-file-if-exists=.env tools/load-realtime.js",
    "match-vehicle-progress": "node --env-file-if-exists=.env tools/match-vehicle-progress.js",
    "check-eta": "node --env-file-if-exists=.env api/check-eta.ts",
    "api": "node --env-file-if-exists=.env api/src/server.ts",
    "test-api": "node --env-file-if-exists=.env api/test-api.ts",
    "check-journey": "node --env-file-if-exists=.env api/check-journey.ts",
    "check-auth": "node --env-file-if-exists=.env api/check-auth.ts",
    "check-crowdsource": "node --env-file-if-exists=.env api/check-crowdsource.ts",
    "test-coordination": "node --env-file-if-exists=.env tools/test-arrival-alarm-coordination.js",
    "simulate-passenger": "node --env-file-if-exists=.env tools/simulate-passenger.js",
    "export-offline": "node --env-file-if-exists=.env tools/export_offline_db.ts",
    "check-all": "npm run check-eta && npm run check-journey && npm run check-auth && npm run check-crowdsource",
    "test-all": "npm run check-eta && npm run check-journey && npm run check-auth && npm run check-crowdsource && npm run test-api && npm run test-coordination",
    "bench": "node --env-file-if-exists=.env api/bench.ts"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "fastify": "^5.12.1",
    "gtfs-realtime-bindings": "^1.1.1",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.2.0",
    "@types/pg": "^8.23.1",
    "typescript": "^7.0.2"
  },
  "type": "module"
}
